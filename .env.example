# Auth
AUTH_SECRET=generate_a_random_32_byte_secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# AI
GEMINI_API_KEY=your_google_ai_studio_key

# AWS Aurora DSQL
DSQL_CLUSTER_ENDPOINT=your_dsql_cluster_endpoint
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=optional_temporary_session_token

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_browser_google_maps_key
GOOGLE_MAPS_KEY=your_server_google_maps_key
GOOGLE_DIRECTIONS_API_KEY=your_google_directions_key
GOOGLE_PLACES_API_KEY=your_google_places_key

# Optional Mapbox fallback
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
