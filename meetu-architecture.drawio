        </mxCell>

        <mxCell id="future" value="&lt;b&gt;Future scalable additions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Object storage for uploaded memories, background workers for heavy exports, analytics/observability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;dashed=1;dashPattern=5 5;fillColor=#FAF8F3;strokeColor=#C8BCA9;fontColor=#6F665E;fontSize=15;spacing=12;" vertex="1" parent="1">
