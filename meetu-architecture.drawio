        </mxCell>

        <mxCell id="local" value="&lt;b&gt;Browser localStorage&lt;/b&gt;&lt;br&gt;Footprints MVP storage&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Memory pins, notes, photo data URLs in current prototype&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFF9EA;strokeColor=#D7BE83;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="1">
