<mxfile host="app.diagrams.net" modified="2026-06-24T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="meetu-architecture" name="MeetU Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MeetU Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=34;fontStyle=1;fontColor=#2F2A24;" vertex="1" parent="1">
          <mxGeometry x="60" y="36" width="500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="AI travel planning agent deployed on Vercel with AWS PostgreSQL-compatible database, Google Gemini, and Google Maps Platform." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#6F665E;" vertex="1" parent="1">
          <mxGeometry x="62" y="86" width="980" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;Web and mobile clients&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Create trips, edit plans, view shared pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fillColor=#F7F4ED;strokeColor=#C8BCA9;fontColor=#302A24;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="210" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="vercelGroup" value="VERCEL" style="swimlane;html=1;startSize=34;rounded=1;arcSize=8;dashed=1;dashPattern=6 6;fillColor=#F1F7FF;strokeColor=#9FBFE0;fontColor=#51759A;fontStyle=1;fontSize=14;swimlaneFillColor=#E5F0FB;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="550" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="edge" value="&lt;b&gt;Vercel Edge / CDN&lt;/b&gt;&lt;br&gt;Static assets, TLS, routing&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Serves the Next.js app globally&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFFFFF;strokeColor=#9FBFE0;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="vercelGroup">
          <mxGeometry x="38" y="65" width="220" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="nextui" value="&lt;b&gt;Next.js Front End&lt;/b&gt;&lt;br&gt;React + TypeScript UI&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Dashboard, editor, overview, gallery, Footprints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFFFFF;strokeColor=#9FBFE0;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="vercelGroup">
          <mxGeometry x="292" y="65" width="220" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;Next.js API Routes&lt;/b&gt;&lt;br&gt;Application backend&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Auth, itinerary generation, save/load trips, routes, hours, exports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFFFFF;strokeColor=#7EA8D1;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="vercelGroup">
          <mxGeometry x="38" y="205" width="474" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;NextAuth&lt;/b&gt;&lt;br&gt;Authentication service&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Google OAuth + email/password sessions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFF5EF;strokeColor=#D8A990;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="vercelGroup">
          <mxGeometry x="38" y="350" width="220" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="exports" value="&lt;b&gt;Export Engine&lt;/b&gt;&lt;br&gt;Poster + PDF generation&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Uses saved itinerary content&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFF9EA;strokeColor=#D7BE83;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="vercelGroup">
          <mxGeometry x="292" y="350" width="220" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="awsGroup" value="AWS DATABASE LAYER" style="swimlane;html=1;startSize=34;rounded=1;arcSize=8;dashed=1;dashPattern=6 6;fillColor=#F0FAF2;strokeColor=#9BC39C;fontColor=#5D835F;fontStyle=1;fontSize=14;swimlaneFillColor=#E4F3E6;" vertex="1" parent="1">
          <mxGeometry x="1030" y="160" width="410" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="&lt;b&gt;AWS Aurora DSQL / PostgreSQL-compatible Database&lt;/b&gt;&lt;br&gt;Primary persistent data store&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Users, accounts, sessions, saved trips, itinerary JSON, messages, share/publish status&lt;/font&gt;" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;shadow=1;fillColor=#FFFFFF;strokeColor=#70A875;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="awsGroup">
          <mxGeometry x="45" y="65" width="320" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="googleGroup" value="GOOGLE SERVICES" style="swimlane;html=1;startSize=34;rounded=1;arcSize=8;dashed=1;dashPattern=6 6;fillColor=#F5F1FF;strokeColor=#C0B4EA;fontColor=#745FA7;fontStyle=1;fontSize=14;swimlaneFillColor=#ECE6FF;" vertex="1" parent="1">
          <mxGeometry x="1030" y="450" width="410" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="gemini" value="&lt;b&gt;Google Gemini API&lt;/b&gt;&lt;br&gt;AI travel agent&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Generates itineraries, refines plans, creates captions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFFFFF;strokeColor=#B8AAE7;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="googleGroup">
          <mxGeometry x="45" y="62" width="320" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="maps" value="&lt;b&gt;Google Maps Platform&lt;/b&gt;&lt;br&gt;Maps, Places, Directions, Static Maps&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Interactive maps, route options, opening hours, poster map image&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFFFFF;strokeColor=#B8AAE7;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="googleGroup">
          <mxGeometry x="45" y="162" width="320" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="oauth" value="&lt;b&gt;Google OAuth&lt;/b&gt;&lt;br&gt;Identity provider" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#FFF5EF;strokeColor=#D8A990;fontColor=#302A24;fontSize=15;spacing=12;" vertex="1" parent="1">
